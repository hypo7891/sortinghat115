rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Hardcoded admin accounts that can read every class/submission
    // regardless of ownership. Adding an admin means adding another email
    // here (and redeploying rules).
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'chiashen@tmail.hc.edu.tw',
        'j27271@tmail.ilc.edu.tw'
      ];
    }

    // Only these accounts may sign in and use the teacher/admin side of the
    // app at all (create classes, read their own data, etc). Keep this in
    // sync with ALLOWED_TEACHER_EMAILS in src/lib/admin.ts.
    function isAllowedTeacher() {
      return isSignedIn() && request.auth.token.email in [
        'chiashen@tmail.hc.edu.tw',
        'j27271@tmail.ilc.edu.tw',
        'rhiannon@tmail.hc.edu.tw',
        'ugsummer@gmail.com',
        'ysjt11435@tmail.hc.edu.tw'
      ];
    }

    function isValidSubmission(data) {
      return data.keys().hasAll([
          'studentDisplayName', 'startedAt', 'completedAt',
          'houseAnswers', 'mbtiAnswers', 'houseScores',
          'primaryHouse', 'secondaryHouse', 'houseTie',
          'mbtiType', 'mbtiAxisScores', 'mbtiAxisStrength',
          'gameScore', 'gameDominantElement'
        ])
        && data.studentDisplayName is string
        && data.studentDisplayName.size() > 0
        && data.studentDisplayName.size() <= 40
        && data.houseAnswers.size() == 12
        && data.mbtiAnswers.size() == 23
        && data.primaryHouse in ['courage', 'wisdom', 'patience', 'composure']
        && data.secondaryHouse in ['courage', 'wisdom', 'patience', 'composure']
        && data.mbtiType is string
        && data.mbtiType.size() == 4
        && data.gameScore is int
        && data.gameDominantElement is string;
    }

    match /teachers/{teacherId} {
      allow read, write: if isAllowedTeacher() && request.auth.uid == teacherId;
    }

    match /joinCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAllowedTeacher() && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isAllowedTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    match /classes/{classId} {
      allow read: if isAdmin() || (isAllowedTeacher() && resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAllowedTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create: if isAllowedTeacher() && request.resource.data.teacherUid == request.auth.uid;

      match /submissions/{submissionId} {
        allow create: if isValidSubmission(request.resource.data);
        allow read: if isAdmin()
          || (isAllowedTeacher()
              && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid);
        allow update, delete: if false;
      }
    }
  }
}
